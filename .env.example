# 請複製成 .env；此檔只提供格式，所有範例都要改成公司的實際值。
# 公司NAS的固定區網IP；勿填Tailscale、QuickConnect或外網位址。
NAS_LAN_IP=192.168.1.20
# 限定辦公室網段；勿加入100.64.0.0/10、Docker網段或全部位址。
OFFICE_CIDRS=192.168.1.0/24
# 以DSM管理員查詢既有共用帳號的數字UID/GID，不是帳號名稱。
HR_UID=1026
HR_GID=100
# 新的人資資料庫位置；先建立並給HR_UID寫入權限。
HR_DATA_PATH=/volume1/docker/baiqi-hr/data
# 沿用原有三個資料夾，先確認存在。可包含中文與空格。
NAS_IDENTITY_PATH=/volume1/人事資料/身分證
NAS_BANK_PATH=/volume1/人事資料/存摺
NAS_LICENSE_PATH=/volume1/人事資料/駕照
# 選填：打卡系統原/exec網址。密鑰必須與Apps Script專案屬性相同。
HR_GAS_URL=
HR_GAS_SECRET=
